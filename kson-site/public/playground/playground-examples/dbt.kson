version: 2
models:
  - name: my_transformation
    description: 'This model transforms raw data'
    columns:
      - name: id
        description: 'A unique identifier'

      - name: name
        description: 'The name of the item'
        .
    database: your_database
    schema: your_schema
    materialized: table
    sql: %sql
      SELECT
        id,
        name
      FROM source_data%%